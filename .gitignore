# Environment / secrets
.env
.env.local
.env.*.local

# Python build
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Editor / tool state
.claude/
.codegraph/
.playwright-mcp/

# Global data (recall db, prompt cache) - legacy, kept for safety
/data/
!data/.gitkeep

# Frontend build artifacts
web/node_modules/
web/dist/
web/.vite/

# Per-project workspaces: each is independent git repo, ignored by main repo
workspaces/*/
!workspaces/.gitkeep

# Legacy workspace work dirs (old arch)
novel_project/work/
!novel_project/work/.gitkeep
!novel_project/work/reports/
novel_project/work/reports/*
!novel_project/work/reports/.gitkeep

# Archived legacy (node_modules + workspace content not tracked)
archive/legacy/web/node_modules/
archive/legacy_workspaces/*/

# OpenCode internal state (session ledger/evidence kept on disk, not versioned)
.omo/
